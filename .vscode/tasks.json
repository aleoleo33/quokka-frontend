{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quokka: Start Dev Server",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["start"],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting Metro.*",
          "endsPattern": "^.*Metro waiting.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Quokka: Open Web Preview",
      "type": "shell",
      "command": "start",
      "args": ["http://localhost:8082"],
      "presentation": {
        "echo": false,
        "reveal": "silent"
      }
    }
  ]
}
